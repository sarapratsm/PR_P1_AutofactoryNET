<Window x:Class="AutofactoryNET.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutofactoryNET"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Background="{StaticResource BackgroundLightBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="./Images/image.ico"
        Title="AutoFactory" Height="600" Width="900">

    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Menú">
                <MenuItem Header="Inici"  x:Name="mnuInici" Click="mnuInici_Click"></MenuItem>
                <MenuItem Header="Productes" x:Name="mnuProductes" Click="mnuProductes_Click"></MenuItem>
                <MenuItem Header="Components" x:Name="mnuComponentes" Click="mnuComponentes_Click"></MenuItem>
            </MenuItem>
            <MenuItem Header="Ajuda">Porfa</MenuItem>
        </Menu>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="Banner" Grid.Row="0" Margin="10">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top">

                    <Grid Grid.Column="1" Width="30" Height="30">
                        <Ellipse Fill="{StaticResource AccentBrush}" Opacity="0.1"/>
                        <Path Data="M60,25 L45,90 L55,90 L60,75 L75,75 L80,90 L90,90 L75,25 Z"
                              Fill="{StaticResource PrimaryBrush}" Stretch="Uniform"/>
                    </Grid>

                    <TextBlock Text="AutoFactory" x:Name="txbTitle"
                               HorizontalAlignment="Left" Grid.Column="0"
                               VerticalAlignment="Center" Margin="50,0,0,0"
                               Style="{StaticResource TitleTextStyle}"/>
                </StackPanel>
            </Grid>
            
            <Frame x:Name="frmMain" Grid.Row="1" NavigationUIVisibility="Hidden"></Frame>
        </Grid>
    </DockPanel>
</Window>