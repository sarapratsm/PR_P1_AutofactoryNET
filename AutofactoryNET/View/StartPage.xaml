<Page x:Class="AppAutoFactory.View.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AppAutoFactory.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="{StaticResource WindowBackground}"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      Title="StartPage">

    

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <StackPanel Margin="0,0,0,40">
                <TextBlock Text="AutoFactory" 
                           FontSize="48" 
                           FontWeight="Bold" 
                           Foreground="#374151" 
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI"/>

                <TextBlock Text="Sistema de Gestió de Producció" 
                           FontSize="18" 
                           Foreground="#6B7280" 
                           HorizontalAlignment="Center" 
                           Margin="0,5,0,20"/>

                <Border Background="White" CornerRadius="20" Padding="15,5" HorizontalAlignment="Center" BorderThickness="1" BorderBrush="#E5E7EB">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{Binding Foreground, ElementName=lblServerStatus}" Margin="0,0,10,0"/>
                        <Label x:Name="lblServerStatus" 
                               Content="Inicialitzant..." 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" x:Name="stpBotons">

                <Button x:Name="btnVeureProductes" Click="btnVeureProductes_Click" 
                        Style="{StaticResource TileButtonStyle}" Width="200" Height="200">
                    <StackPanel>
                        <TextBlock Text="📦" FontSize="50" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBlock Text="Productes" FontSize="20" FontWeight="Bold" Foreground="#374151" HorizontalAlignment="Center"/>
                        <TextBlock Text="Gestió d'inventari" FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnVeureComponents" Click="btnVeureComponents_Click" 
                        Style="{StaticResource TileButtonStyle}" Width="200" Height="200">
                    <StackPanel>
                        <TextBlock Text="⚙️" FontSize="50" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBlock Text="Components" FontSize="20" FontWeight="Bold" Foreground="#374151" HorizontalAlignment="Center"/>
                        <TextBlock Text="Peces i proveïdors" FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>

            </StackPanel>

            <TextBlock Text="© 2025 AutoFactory System" FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,50,0,0"/>

        </StackPanel>
    </Grid>
    
