<Page x:Class="AppAutoFactory.View.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AppAutoFactory.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="{StaticResource BackgroundLightBrush}"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      Title="StartPage">

    <DockPanel LastChildFill="True">
        <StackPanel Orientation="Horizontal" x:Name="stpBotons" Grid.Column="0" Grid.Row="1" Margin="0,0,0,50" HorizontalAlignment="Center" DockPanel.Dock="Bottom">
            <Button Margin="20,5,20,5" Click="btnVeureProductes_Click" x:Name="btnVeureProductes" Content="Gestió de productes" Width="auto" Cursor="Hand"  />
            <Button Margin="20,5,20,5" Click="btnVeureComponents_Click" x:Name="btnVeureComponents" Content="Gestió de components" Width="auto"  />
        </StackPanel>
        <!--Aixo s'ha de treure-->
        <!---->
        <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="10" Margin="50" CornerRadius="10" Background="{StaticResource WindowBackground}">
            <StackPanel Orientation="Vertical" x:Name="stpTitle" Grid.Column="0" Grid.Row="0" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" >
            <TextBlock Text="Welcome to" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource SubtitleTextStyle}"/>
            <TextBlock Text="AutoFactory" FontSize="50" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}"/>
        <Label x:Name="lblServerStatus" DockPanel.Dock="Top" HorizontalAlignment="Center">Estat del servidor</Label>
            </StackPanel>
        </Border>
    </DockPanel>
</Page>
