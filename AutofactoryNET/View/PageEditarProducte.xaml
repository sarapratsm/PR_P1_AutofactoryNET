<Page x:Class="AppAutoFactory.View.PageEditarProducte"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AppAutoFactory.View" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Background="{StaticResource WindowBackground}"
      Title="Gestió de Producte">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txbTitol" Text="Gestió del Producte" Style="{StaticResource TitleTextStyle}" Grid.Row="0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Catàleg d'Items" Style="{StaticResource SubtitleTextStyle}" Grid.Row="0"/>

                <StackPanel Grid.Row="0" Margin="0,30,0,10">
                    <TextBox x:Name="txtFiltreNom"  Tag="Busca per Nom..." Margin="0,5"/>
                    <TextBox x:Name="txtFiltreCodi"  Tag="Busca per Codi..." Margin="0,5"/>
                    <Button x:Name="btnFiltrar" Content="🔍 Filtrar" Click="btnFiltrar_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"/>
                </StackPanel>

                <DataGrid x:Name="dtgItems" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="dtgItems_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Codi" Binding="{Binding Codi}" Width="80"/>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Background="#FFEFEFEF" CornerRadius="5" Padding="10" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Afegir al BOM:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtQuantitatSubcomp"  Text="1" ToolTip="Quantitat"/>
                            <Button x:Name="btnAfegirSubcomp" Click="btnAfegirSubcomp_Click" Content="➕ Add" Grid.Column="1" Margin="5,0,0,0" IsEnabled="False"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,15" Background="White">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1" Width="100" Height="100" VerticalAlignment="Top" Margin="0,0,15,0">
                            <Image Source="{Binding Foto}" Stretch="Uniform"/>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Label Content="Codi:" FontWeight="Bold" Grid.Row="0" Grid.Column="0"/>
                            <TextBox Text="{Binding Codi}" IsReadOnly="True"  Background="#FFF0F0F0" Grid.Row="0" Grid.Column="1" Margin="5"/>

                            <Label Content="Nom:" FontWeight="Bold" Grid.Row="1" Grid.Column="0"/>
                            <TextBox Text="{Binding Nom}"  Grid.Row="1" Grid.Column="1" Margin="5"/>

                            <Label Content="Stock:" FontWeight="Bold" Grid.Row="2" Grid.Column="0"/>
                            <TextBox Text="{Binding Stock}"  Grid.Row="2" Grid.Column="1" Margin="5" HorizontalAlignment="Left" Width="100"/>

                            <Label Content="Descripció:" FontWeight="Bold" Grid.Row="3" Grid.Column="0" VerticalAlignment="Top" Margin="0,5,0,0"/>
                            <TextBox Text="{Binding Descripcio}"  Grid.Row="3" Grid.Column="1" Margin="5" Height="60" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Bill of Materials (Contingut)" Style="{StaticResource SubtitleTextStyle}" Grid.Row="0"/>

                    <DataGrid x:Name="dtgBOM" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="dtgSubcomponents_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Quantitat" Binding="{Binding Value}" Width="80"/>
                            <DataGridTextColumn Header="Unitat" Binding="{Binding Key.Unitat}" Width="80"/>
                            <DataGridTextColumn Header="Codi" Binding="{Binding Key.Codi}" Width="100"/>
                            <DataGridTextColumn Header="Nom" Binding="{Binding Key.Nom}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button x:Name="btnEliminarSubcomp" Click="btnEliminarSubcomp_Click" Content="🗑️ Eliminar Element Seleccionat" HorizontalAlignment="Right" Margin="0,5,0,3" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnGuardar" Grid.Column="1" Content="Guarda"   Click="btnGuardar_Click" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="15,5"/>
            <Button x:Name="btnCancel" Grid.Column="0" Content="Cancel·la"   Click="btnCancel_Click"  HorizontalAlignment="Left" Margin="0,10,0,0" Padding="15,5" Style="{StaticResource SecondaryButton}"/>
        </Grid>

    </Grid>
</Page>