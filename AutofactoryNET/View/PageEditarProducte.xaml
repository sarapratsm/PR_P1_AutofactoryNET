<Page x:Class="AppAutoFactory.View.PageEditarProducte"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AppAutoFactory.View" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Background="{StaticResource WindowBackground}"
      Loaded="Page_Loaded"
      Title="Gestió de Producte">

    <Grid Margin="15,15,20,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txbTitol" Text="Gestió del Producte" Style="{StaticResource TitleTextStyle}" Grid.Row="0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Catàleg d'Items" Style="{StaticResource SubtitleTextStyle}" Grid.Row="0"/>

                <StackPanel Grid.Row="0" Margin="0,30,0,10">
                    <Label Content="filtre per nom:"></Label>
                    <TextBox x:Name="txbFiltreNom"  Tag="Busca per Nom..." Margin="0,5"/>
                    <Label Content="filtre per codi:"></Label>
                    <TextBox x:Name="txbFiltreCodi"  Tag="Busca per Codi..." Margin="0,5"/>
                    <Label Content="filtre per tipus:"></Label>
                    <ComboBox x:Name="cmbTipus" SelectionChanged="cmbTipus_SelectionChanged">
                        <ComboBoxItem Content="Components" ></ComboBoxItem>
                        <ComboBoxItem Content="Productes"></ComboBoxItem>
                    </ComboBox>
                    <Button x:Name="btnFiltrar" Content="🔍 Filtrar" Click="btnFiltrar_Click" Margin="5,10,0,0" Style="{StaticResource FilterButtonStyle}" HorizontalAlignment="Right"/>

                </StackPanel>

                <DataGrid x:Name="dtgItems" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="dtgItems_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Codi" Binding="{Binding Codi}" Width="80"/>
                        <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Background="#FFEFEFEF" CornerRadius="5" Padding="10" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Afegir al BOM:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtQuantitatSubcomp"  Text="1" ToolTip="Quantitat"/>
                            <Button x:Name="btnAfegirSubcomp" Click="btnAfegirSubcomp_Click" Content="➕ Add" Grid.Column="1" Margin="5,0,0,0" IsEnabled="False"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,15" Background="White">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="stpFoto" Grid.Column="0">
                            <Border  BorderBrush="LightGray" BorderThickness="1" Width="100" Height="100" VerticalAlignment="Top" Margin="0,0,15,0">
                                <Image x:Name="imgProducte" Source="{Binding Foto}" Stretch="Uniform"/>
                            </Border>
                            <Button x:Name="btnPujarFoto" Click="btnPujarFoto_Click" Content="Upload" ToolTip="Pujar imatge"
                                 Margin="5,5,20,0"/>
                            <Button x:Name="btnRemoveFoto" Click="btnRemoveFoto_Click" Content="Remove" ToolTip="Eliminar imatge"
                                Style="{StaticResource FilterButtonStyle}" Margin="5,5,20,0"/>




                        </StackPanel>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Label Content="Codi:" FontWeight="Bold" Grid.Row="0" Grid.Column="0"/>
                            <TextBox x:Name="txbCodi" Text="{Binding Codi}" Grid.Row="0" Grid.Column="1" Margin="5"/>

                            <Label Content="Nom:" FontWeight="Bold" Grid.Row="1" Grid.Column="0"/>
                            <TextBox x:Name="txbNom" Text="{Binding Nom, Mode=TwoWay}"  Grid.Row="1" Grid.Column="1" Margin="5"/>

                            <Label Content="Stock:" FontWeight="Bold" Grid.Row="2" Grid.Column="0"/>
                            <TextBox x:Name="txbStock" Text="{Binding Stock, Mode=TwoWay}"  Grid.Row="2" Grid.Column="1" Margin="5" HorizontalAlignment="Left" Width="100"/>

                            <Label Content="Descripció:" FontWeight="Bold" Grid.Row="3" Grid.Column="0" VerticalAlignment="Top" Margin="0,5,0,0"/>
                            <TextBox x:Name="txbDesc" Text="{Binding Descripcio, Mode=TwoWay}"  Grid.Row="3" Grid.Column="1" Margin="5" Height="60" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Bill of Materials (Contingut)" Style="{StaticResource SubtitleTextStyle}" Grid.Row="0"/>

                    <DataGrid x:Name="dtgBOM" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="dtgBOM_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Quantitat" Binding="{Binding Value}" Width="80"/>
                            <DataGridTextColumn Header="Unitats" Binding="{Binding Key.Unitat}"/>
                            <DataGridTextColumn Header="Codi" Binding="{Binding Key.Codi}" Width="100"/>
                            <DataGridTextColumn Header="Nom" Binding="{Binding Key.Nom}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button x:Name="btnEliminarSubcomp" Click="btnEliminarSubcomp_Click" Content="🗑️ Retirar Element del BOM" HorizontalAlignment="Right" Margin="0,5,0,3" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Label x:Name="lblLoading" VerticalAlignment="Bottom"></Label>
                <Button x:Name="btnImprimirBOM" Content="Imprimir BOM" Click="ImprimirBOM_Click" HorizontalAlignment="Right" Margin="0,10,10,0" Padding="15,5"/>
                <Button x:Name="btnGuardar"  Content="Guarda"   Click="btnGuardar_Click" HorizontalAlignment="Right" Margin="0,10,10,0" Padding="15,5"/>
            </StackPanel>
            <Button x:Name="btnCancel" Grid.Column="0" Content="Cancel·la"   Click="btnCancel_Click"  HorizontalAlignment="Left" Margin="0,10,0,0" Padding="15,5" Style="{StaticResource SecondaryButton}"/>
        </Grid>

    </Grid>
</Page>