<Page x:Class="AppAutoFactory.View.PageDtgProductes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AppAutoFactory.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Loaded="Page_Loaded"
      Background="{StaticResource WindowBackground}"
      Title="PageDtgProductes">

    <Page.Resources>
        <local:BytesToImageConverter x:Key="ImageConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="grdControls">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--Filtres-->
            <GroupBox Background="{StaticResource WindowBackground}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Header="Filtres" Margin="15,10,10,0" Padding="10" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                <StackPanel x:Name="stpFiltres" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" >
                    <Label Content="Codi:"></Label>
                    <TextBox x:Name="txtFiltreCodi" Width="150" Margin="10,10,10,0"  ToolTip="Filtre Codi" />
                    <Label Content="Nom:"></Label>
                    <TextBox x:Name="txtFiltreNom" Width="150" Margin="10,10,10,0"  ToolTip="Filtre Nom" />

                    <Button x:Name="btnFiltrar" Content="🔍 Filtrar" Margin="10,10,10,0" Click="btnFiltrar_Click" Style="{StaticResource FilterButtonStyle}"/>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Vertical" x:Name="stpBotons" Grid.Column="0" Grid.Row="1" Margin="20" HorizontalAlignment="center">
                <Button Margin="10,10,0,0" Click="btnAfegirProducte_Click"  x:Name="btnAfegirProducte" Content="Crear nou producte" Width="auto"  />
                <!--<Button x:Name="btnBOM" Click="btnBOM_Click" Content="Crear BOM" Margin="10,10,0,0" />-->
                <Button Margin="10,10,0,0" Click="btnModificar_Click" x:Name="btnModificar" Content="Modificar" Width="auto"/>
                <Button Style="{StaticResource SecondaryButton}" Margin="10,10,0,0" Click="btnEliminar_Click"  x:Name="btnEliminar" Content="Eliminar" Width="auto" />
            </StackPanel>
        </Grid>
        <Grid Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="dtgProductes" Grid.Row="0"
              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
              MouseDoubleClick="dtgProductes_MouseDoubleClick"
              SelectionChanged="dtgProductes_SelectionChanged"
              VerticalScrollBarVisibility="Auto" 
              HorizontalScrollBarVisibility="Auto">

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Foto" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Foto, Converter={StaticResource ImageConverter}}" 
                               Width="40" Height="40" 
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Codi" Binding="{Binding Codi}" Width="80" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*" MinWidth="100"/>
                    <DataGridTextColumn Header="Tipus" Binding="{Binding Tipus}" Width="50">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Descripció" Binding="{Binding Descripcio}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding Descripcio}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" x:Name="stpPaginacio" HorizontalAlignment="Center" Margin="0,10,0,10">
                <Button x:Name="btnFirst" Content="&lt;&lt;" Margin="5,0,0,0" Click="btnFirst_Click" Style="{StaticResource TileButtonStyle}" Width="30"/>
                <Button x:Name="btnPrevious" Content="&lt;" Margin="5,0,0,0" Click="btnPrevious_Click" Style="{StaticResource TileButtonStyle}" Width="30"/>
                <TextBox x:Name="txtPagina" Width="60" Margin="5,0,0,0" TextAlignment="Center" IsReadOnly="True"/>
                <Button x:Name="btnNext" Content="&gt;" Margin="5,0,0,0" Click="btnNext_Click" Style="{StaticResource TileButtonStyle}" Width="30"/>
                <Button x:Name="btnLast" Content="&gt;&gt;" Margin="5,0,0,0" Click="btnLast_Click" Style="{StaticResource TileButtonStyle}" Width="30"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>


