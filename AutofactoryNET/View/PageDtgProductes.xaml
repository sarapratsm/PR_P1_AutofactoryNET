<Page x:Class="AppAutoFactory.View.PageDtgProductes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AppAutoFactory.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Loaded="Page_Loaded"
      Background="{StaticResource WindowBackground}"
      Title="PageDtgProductes">
   
    <Page.Resources>
        <local:BytesToImageConverter x:Key="ImageConverter"/>
    </Page.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="grdControls">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--Filtres-->
            <GroupBox Background="{StaticResource WindowBackground}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Header="Filtres" Margin="15,10,10,0" Padding="10" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                <StackPanel x:Name="stpFiltres" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" >
                    <Label Content="Codi:"></Label>
                    <TextBox x:Name="txtFiltreCodi" Width="150" Margin="10,10,10,0"  ToolTip="Filtre Codi" />
                    <Label Content="Nom:"></Label>
                    <TextBox x:Name="txtFiltreNom" Width="150" Margin="10,10,10,0"  ToolTip="Filtre Nom" />

                    <Button x:Name="btnFiltrar" Content="🔍 Filtrar" Margin="10,10,10,0" Click="btnFiltrar_Click" Style="{StaticResource FilterButtonStyle}"/>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Vertical" x:Name="stpBotons" Grid.Column="0" Grid.Row="1" Margin="20" HorizontalAlignment="center">
                <Button Margin="10,10,0,0" Click="btnAfegirProducte_Click"  x:Name="btnAfegirProducte" Content="Crear nou producte" Width="auto"  />
                <Button Margin="10,10,0,0" Click="btnModificar_Click" x:Name="btnModificar" Content="Modificar" Width="auto"/>
                <Button Style="{StaticResource SecondaryButton}" Margin="10,10,0,0" Click="btnEliminar_Click"  x:Name="btnEliminar" Content="Eliminar" Width="auto" />
            </StackPanel>
        </Grid>
        <Grid Grid.Column="1">
            <DataGrid x:Name="dtgProductes" Margin="10"
              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
              MouseDoubleClick="dtgProductes_MouseDoubleClick"
              SelectionChanged="dtgProductes_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding TheImatge, Converter={StaticResource ImageConverter} ,FallbackValue=https://picsum.photos/seed/picsum/50}" Width="50" Height="50" Stretch="UniformToFill"></Image>
                                <!--<Label Content="&lt;3"></Label>-->
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Codi" Binding="{Binding Codi}" Width="75"/>
                    <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*"/>
                    <DataGridTextColumn Header="Tipus" Binding="{Binding Tipus}" Width="50"/>
                    <DataGridTextColumn Header="Descripció" Binding="{Binding Descripcio}" Width="250"/>
                    <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="80"/>

                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Page>


