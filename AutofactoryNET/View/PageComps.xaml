<Page x:Class="AppAutoFactory.View.PageComps"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AppAutoFactory.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Loaded="Page_Loaded"
      Background="{StaticResource WindowBackground}"
      Title="Components">
    <DockPanel LastChildFill="True">
        <!--Toolbar-->
        <Grid DockPanel.Dock ="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!--<TextBlock Text="🔍" VerticalAlignment="Center" Margin="5,0,5,0" Opacity="0.4"/>-->
                <Label Content="Codi:"></Label>
                <TextBox x:Name="txtFiltreCodi" Width="80" Margin="5,0" Tag="Codi..."/>
                <Label Content="Nom:"></Label>
                <TextBox x:Name="txtFiltreNom" Width="130" Margin="5,0" Tag="Nom..."/>

                <Button x:Name="btnFiltrar" Click="btnFiltrar_Click" Content="🔍 Filtrar"
                    Style="{StaticResource FilterButtonStyle}"/>


            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                

                <Button x:Name="btnModificar" Click="btnModificar_Click" Content="✏️" ToolTip="Modificar"
                    Background="Transparent" BorderBrush="Transparent" FontSize="18" Margin="2,0" Cursor="Hand"/>

                <Button x:Name="btnEliminar" Click="btnEliminar_Click" Content="🗑️" ToolTip="Eliminar"
                    Background="Transparent" BorderBrush="Transparent" FontSize="18" Margin="2,0" Cursor="Hand"/>

                <Button x:Name="btnGestioProvs" Click="btnGestioProvs_Click" Content="🚚" ToolTip="Proveïdors"
                    Background="Transparent" BorderBrush="Transparent" FontSize="18" Margin="2,0" Cursor="Hand"/>

                <Button x:Name="btnAfegir" Click="btnAfegir_Click" Content="➕ Nou"
    Background="{StaticResource PrimaryBrush}" Foreground="White" FontWeight="SemiBold"
    Padding="15,6" Margin="0,0,15,0" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

            </StackPanel>
        </Grid>
        <!--<ToolBar  Margin="5" DockPanel.Dock ="Top">
            <Label Content="Codi:"/>
            <TextBox x:Name="txtFiltreCodi" Width="100" Margin="0,0,10,0"/>
            <Label Content="Nom:"/>
            <TextBox x:Name="txtFiltreNom" Width="150" Margin="0,0,10,0"/>
            <Button x:Name="btnFiltrar" Content="Filtrar" Margin="0,0,10,0" Click="btnFiltrar_Click"/>

            <Separator/>

            <Button x:Name="btnAfegir" Content="Afegir Component" Click="btnAfegir_Click"/>
            <Button x:Name="btnModificar" Content="Modificar" Margin="5,0,0,0" Click="btnModificar_Click"/>
            <Button x:Name="btnEliminar" Content="Eliminar" Margin="5,0,0,0" Click="btnEliminar_Click"/>
            <Button x:Name="btnGestioProvs" Content="Gestiona Proveidors" Margin="5,0,0,0" Click="btnGestioProvs_Click"/>
        </ToolBar>-->

        <Grid Margin="10"  x:Name="grdBotonera" DockPanel.Dock="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="stp_esquerra" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" x:Name="btnCancel" Click="btnCancel_Click" Content="Cancel·la" Margin="10,0,10,0"></Button>
                <Button x:Name="btnEditarProvs" Click="btnEditarProvs_Click" >Gestionar proveidors</Button>
            </StackPanel  >
            <StackPanel Orientation="Horizontal" Grid.Column="1" x:Name="stp_dreta" HorizontalAlignment="Right">
                <Button    x:Name="btnSave" Click="btnSave_Click" Grid.Column="0">Guarda</Button>
            </StackPanel>
        </Grid>


        <!--Es troba al centre del dockpanel-->
        <Grid x:Name="grdCentral" Margin="10,5,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid x:Name="grdCamps" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <!--Labels-->
                <Label Margin="10" Padding="5" Content="Codi*" Grid.Row="1"></Label>
                <Label Margin="10" Padding="5" Content="Nom*" Grid.Row="2"></Label>
                <Label Margin="10" Padding="5" Content="Descripcio" Grid.Row="3"></Label>
                <Label Margin="10" Padding="5" Content="Fabricant*" Grid.Row="4"></Label>
                <Label Margin="10" Padding="5" Content="Stock*" Grid.Row="5"></Label>
                <Label Margin="10" Padding="5" Content="Unitats*" Grid.Row="6"></Label>

                <Image x:Name="imgComp" Grid.Column="1" Grid.Row="0" Width="50" Height="50" HorizontalAlignment="Right" Source="{Binding Foto}"></Image>
                <!--Falta la foto aqui-->
                <TextBox  x:Name="txbNom" Margin="10" Padding="5"   Grid.Column="1" Width="100" Grid.Row="1" Text="{Binding Codi, Mode=TwoWay}" IsEnabled="False"/>
                <TextBox  Margin="10" Padding="5" Grid.Column="1" Width="100" Grid.Row="2"   Text="{Binding Nom, Mode=TwoWay}"/>
                <TextBox  Margin="10" Padding="5" Grid.Column="1" Width="100" Grid.Row="3"   Text="{Binding Descripcio, Mode=TwoWay}"/>
                <TextBox  Margin="10" Padding="5" Grid.Column="1" Width="100" Grid.Row="4"   Text="{Binding CodiFabricant, Mode=TwoWay}"/>
                <TextBox  Margin="10" Padding="5" Grid.Column="1" Width="100" Grid.Row="5"   Text="{Binding Stock, Mode=TwoWay}"/>
                <ComboBox x:Name="cmbUnitats" Margin="10" Padding="5"  Grid.Column="1" Width="100"  Grid.Row="6" Text="{Binding Unitat}"/>
            </Grid>

            <DataGrid x:Name="dtgComps" Grid.Column="1" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  SelectionMode="Single"
                      MouseDoubleClick="dtgComps_MouseDoubleClick"
                      SelectionChanged="dtgComps_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Codi" Binding="{Binding Codi}" Width="100"/>
                    <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*"/>
                    <DataGridTextColumn Header="Fabricant" Binding="{Binding CodiFabricant}" Width="100"/>
                    <DataGridTextColumn Header="Unitat" Binding="{Binding Unitat}" Width="80"/>
                    <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>


    </DockPanel>
</Page>
