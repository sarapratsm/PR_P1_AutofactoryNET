<Page x:Class="AppAutoFactory.View.PageProds"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AppAutoFactory.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Loaded="Page_Loaded"
      Title="PageProds">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <TextBlock Text="Productes"></TextBlock>
        <ToolBar Grid.Row="0" Margin="5">
            <Label Content="Codi:"/>
            <TextBox x:Name="txtFiltreCodi" Width="100" Margin="0,0,10,0"/>
            <Label Content="Nom:"/>
            <TextBox x:Name="txtFiltreNom" Width="150" Margin="0,0,10,0"/>
            <Button x:Name="btnFiltrar" Content="Filtrar" Margin="0,0,10,0"/>

            <Separator/>

            <Button x:Name="btnAfegir" Content="Afegir Producte"/>
            <Button x:Name="btnModificar" Content="Modificar" Margin="5,0,0,0"/>
            <Button x:Name="btnEliminar" Content="Eliminar" Margin="5,0,0,0"/>
        </ToolBar>

        <DataGrid x:Name="dtgProductes" Grid.Row="1" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Codi" Binding="{Binding Codi}" Width="120"/>
                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
