<Page x:Class="AppAutoFactory.View.PageCompProv"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AppAutoFactory.View"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Background="{StaticResource WindowBackground}"
      Loaded="Page_Loaded" Title="Gestió de Proveïdors per Component">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="lblComponent" Text="Dades del Component" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" Style="{StaticResource SubtitleTextStyle}"/>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10">
            <StackPanel>
                <Label Content="Codi:" FontWeight="Bold"/>
                <TextBox x:Name="txtCodi" IsReadOnly="True" Margin="5,0,0,10"/>

                <Label Content="Nom:" FontWeight="Bold"/>
                <TextBox x:Name="txtNom" IsReadOnly="True" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,15,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <Label Content="Proveïdor:"/>
                <ComboBox x:Name="cmbProveidors"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <Label Content="Preu:"/>
                <TextBox x:Name="txtPreu" Width="100"/>
            </StackPanel>
 
            <Button x:Name="btnAfegirProveidor" Content="Afegir" Grid.Column="2" VerticalAlignment="Bottom" Padding="10,5" Click="btnAfegirProveidor_Click" />
        </Grid>

        <DataGrid x:Name="dtgCompProv" Grid.Row="3"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Proveïdor (Nom)" Binding="{Binding RaoSocial}" Width="*"/>
                <DataGridTextColumn Header="CIF" Binding="{Binding Cif}" Width="150"/>
                <DataGridTextColumn Header="Preu" Binding="{Binding Preu}" Width="100"/>
            </DataGrid.Columns>

        </DataGrid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnGuardar" Grid.Column="1" Content="Guardar"   Click="btnGuardar_Click" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="15,5"/>
            <Button x:Name="btnCancel" Grid.Column="0" Content="Cancel"   Click="btnCancel_Click"  HorizontalAlignment="Left" Margin="0,10,0,0" Padding="15,5" Style="{StaticResource SecondaryButton}"/>
        </Grid>

    </Grid>
</Page>