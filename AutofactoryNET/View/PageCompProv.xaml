<Page x:Class="AppAutoFactory.View.PageCompProv"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AppAutoFactory.View"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Background="{StaticResource WindowBackground}"
      Loaded="Page_Loaded" Title="Gestió de Proveïdors per Component">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="lblComponent" Text="Dades del Component" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" Style="{StaticResource SubtitleTextStyle}"/>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>

                </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Label Content="Rao social:" FontWeight="Bold"/>
                <TextBox x:Name="txtRaoSocial"  Margin="5,0,0,10"/>

                <Label Content="CIF:" FontWeight="Bold"/>
                <TextBox x:Name="txtCifFiltre"  Margin="5,0,0,0"/>
            </StackPanel>
                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="filtraCombo" Content="Filtra nous proveidors"  Margin="0,10,0,0" Click="filtraCombo_Click"  Style="{StaticResource FilterButtonStyle}"></Button>
                    <Button x:Name="filtraDtg" Content="Filtra proveidors actuals" Margin="0,10,0,0" Click="filtraDtg_Click"   Style="{StaticResource FilterButtonStyle}"></Button>
                    <Button x:Name="netejaFiltres" Content="Neteja filtres" Margin="0,10,0,0" Click="netejaFiltres_Click" Style="{StaticResource SecondaryButton}"></Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,15,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <Label Content="Nou proveïdor:"/>
                <ComboBox x:Name="cmbProveidors"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <Label Content="Preu:"/>
                <TextBox x:Name="txtPreu" Width="100"/>
            </StackPanel>
 
            <Button x:Name="btnAfegirProveidor" Content="Afegir" Grid.Column="2" VerticalAlignment="Bottom" Padding="10,5" Click="btnAfegirProveidor_Click" />
        </Grid>

        <DataGrid x:Name="dtgCompProv" Grid.Row="3" SelectionChanged="dtgCompProv_SelectionChanged"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Nom del proveïdor" Binding="{Binding RaoSocial}" Width="*"/>
                <DataGridTextColumn Header="CIF" Binding="{Binding Cif}" Width="150"/>
                <DataGridTextColumn Header="Preu" Binding="{Binding Preu}" Width="100"/>
            </DataGrid.Columns>

        </DataGrid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnGuardar" Grid.Column="1" Content="Guarda"   Click="btnGuardar_Click" HorizontalAlignment="Right" Margin="0,10,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="btnCancel" Grid.Column="0" Content="Cancel·la"   Click="btnCancel_Click"  HorizontalAlignment="Left" Margin="0,10,10,0"  Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="btnEliminarProveidor" Click="btnEliminarProveidor_Click" Content="Eliminar proveïdor" Margin="0,10,10,0" Style="{StaticResource SecondaryButton}"></Button>
            </StackPanel> 
        </Grid>

    </Grid>
</Page>